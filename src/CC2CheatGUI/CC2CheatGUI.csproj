<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CC2CheatGUI</AssemblyName>
    <RootNamespace>CC2CheatGUI</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Carrier Command 2 Cheat GUI</Product>
    <AssemblyTitle>Carrier Command 2 Cheat GUI</AssemblyTitle>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- LanaPixel (SIL OFL) — the game's own UI font, bundled for an authentic look. -->
    <EmbeddedResource Include="Assets\lanapixel.ttf" />
  </ItemGroup>

</Project>
